# AWS source (credentials come from the VM IAM role / instance profile)
AWS_REGION=ap-south-1
AWS_SOURCE_BUCKET=my-aws-source-bucket
# Optional: only copy keys under this prefix
# AWS_SOURCE_PREFIX=logs/

# GCP destination
GCP_DEST_BUCKET=my-gcp-dest-bucket
# Optional: prepend this prefix to every object in the destination
# GCP_DEST_PREFIX=aws-sync/
# Path to the GCP service account JSON key
GOOGLE_APPLICATION_CREDENTIALS=./gcp-sa.json

# Optional behaviour
# SKIP_EXISTING=false   # needs storage.objects.get; leave false for write-only SAs
# DRY_RUN=false
