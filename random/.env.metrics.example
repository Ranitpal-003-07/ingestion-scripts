# CtrlB metrics (PromQL alert test data) — no Authorization required
# Metrics URL = {endpoint}/v1/metrics ; STREAM_NAME goes in stream-name header
OTEL_EXPORTER_OTLP_ENDPOINT=https://staging.ctrlb.dev/engine/api/default
STREAM_NAME=your_metrics_stream
# Optional explicit full URL:
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://staging.ctrlb.dev/engine/api/default/v1/metrics

METRICS_EXPORT_INTERVAL_SECONDS=5
METRICS_TICKS_PER_SECOND=1
DEPLOYMENT_ENV=demo

# New Relic alternative:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
# NEW_RELIC_LICENSE_KEY=NRAK-xxxxxxxx
# STREAM_NAME=
