# CtrlB traces (APM query test data) — no Authorization required
# Traces URL = {endpoint}/v1/traces ; STREAM_NAME goes in stream-name header
OTEL_EXPORTER_OTLP_ENDPOINT=https://staging.ctrlb.dev/engine/api/default
STREAM_NAME=your_traces_stream
# Optional explicit full URL:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://staging.ctrlb.dev/engine/api/default/v1/traces

TRACES_PER_SECOND=5
DEPLOYMENT_ENV=demo
# Metrics disabled automatically for CtrlB; set 0 to force-enable:
# OTLP_DISABLE_METRICS=0

# New Relic alternative:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
# NEW_RELIC_LICENSE_KEY=NRAK-xxxxxxxx
# STREAM_NAME=
