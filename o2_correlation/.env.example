# Match Data Sources / OTEL collector on AP1 Cloud
O2_BASE_URL=https://ap1-api.openobserve.ai
O2_ORG=your_org_id
O2_USER=your-email@example.com
O2_PASSWORD=your_ingest_token

# Same as collector headers.stream-name / curl .../{stream}/_json
O2_LOG_STREAMS=default
O2_TRACE_STREAMS=default
O2_METRICS_STREAMS=default

O2_DEPLOYMENT_ENV=prod
O2_STREAM_HEADER_KEY=stream-name
TICKS_PER_SECOND=1
