# S3 copy — one source, one or more destinations
S3_SOURCE_BUCKET=your-source-bucket
S3_SOURCE_REGION=ap-south-1

# Single dest (still supported):
# S3_DEST_BUCKET=your-dest-bucket
# S3_DEST_REGION=eu-north-1

# Multiple dests — comma-separated (no spaces required):
S3_DEST_BUCKETS=dest-bucket-a,dest-bucket-b,dest-bucket-c
# One region for all dests:
S3_DEST_REGION=eu-north-1
# Or one region per dest (must match bucket count):
# S3_DEST_REGIONS=eu-north-1,us-east-1,ap-south-1

# Optional tuning
# S3_PREFIX=
# Shared dest prefix for all buckets:
# S3_DEST_PREFIX=archive/
# Or one prefix per dest bucket:
# S3_DEST_PREFIXES=archive-a/,archive-b/,archive-c/
# S3_COPY_WORKERS=10
# S3_BATCH_SIZE=10
# S3_BATCH_INTERVAL=0
# S3_RETRY_DELAY=5s

# CtrlB OpenTelemetry
OTEL_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=s3_copy
OTEL_EXPORTER_OTLP_ENDPOINT=https://<INGESTION_HOST>/engine/api/default
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://<INGESTION_HOST>/engine/api/default/<STREAM_NAME>/_otel/v1/logs
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <API_TOKEN>,stream-name=<STREAM_NAME>
