# Copy to .env and edit values. Credentials come from the EC2 IAM role.
AWS_REGION=ap-south-1
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/your-queue-name

# Optional
# SQS_MAX_MESSAGES=1
# SQS_WAIT_SECONDS=20
# SQS_POLL_ROUNDS=1
# SQS_POLL_INTERVAL=5s
# SQS_DELETE_ON_RECEIVE=false
